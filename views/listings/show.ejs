<% layout('layouts/boilerplate') -%>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <div class="row show-card">
    <div class="card col-6 offset-3 listing-card">
    <br> 
    <h2><%= list.title %></h2>
    </div>
    <div class="card col-4 offset-3 listing-card">
    <img src="<%= list.image.url %>" class="card-img-top show-img" alt="listing_img" >
    </div>
    <div class="card-body col-7 offset-3">
    <p class="card-text ">
         <p><i>Owned By <%= list.owner.username %></i></p>
         <p>&nbsp;&nbsp;<%= list.description %> </p> 
         <p>&nbsp;&nbsp;&#8377; <%= list.price.toLocaleString('en-IN') %> /night </p>
         <p>&nbsp;&nbsp;<%= list.country %></p>
         <p>&nbsp;&nbsp;<%= list.location %></p>
    </p>
   </div>
</div>
    
    <% if (currentUser && currentUser._id.equals(list.owner._id)) { %>
    <div class="show-btn mt-5">
    <button class="btn edit-btn offset-3"><a href="/listing/<%= list._id %>/edit" class="show-edit">Edit</a></button>
    <form method="post" action="/listing/<%=list._id%>?_method=DELETE">
    <button class="btn btn-dark offset-5">Delete</button>
    </form>
    </div>

    <% } %>
    
    <div class="row col-6 offset-3 mt-4 mb-4">
        <hr>
        <h4>Where you'll be</h4>
        <div id="map" 
             style="height: 400px; width: 100%; border-radius: 10px; z-index: 1;"
             data-coordinates="<%= JSON.stringify(list.geometry ? list.geometry.coordinates : [0,0]) %>"
             data-title="<%= list.title %>"></div>
    </div>

    <% if (currentUser) { %>
    <div class="row col-6 offset-3 mt-4">
        <hr>
        <h4>Leave a Review: </h4>

    <form action="/listing/<%= list._id %>/reviews" method="post" novalidate class="needs-validation">
     <div>      
  <label for="rating" class="form-label">Rating</label>      
  <fieldset class="starability-slot">
    <input type="radio" id="no-rate" class="input-no-rate" name="rating" value="1" checked aria-label="No rating." />
    <input type="radio" id="first-rate1" name="rating" value="1" />
    <label for="first-rate1" title="Terrible">1 star</label>
    <input type="radio" id="first-rate2" name="rating" value="2" />
    <label for="first-rate2" title="Not good">2 stars</label>
    <input type="radio" id="first-rate3" name="rating" value="3" />
    <label for="first-rate3" title="Average">3 stars</label>
    <input type="radio" id="first-rate4" name="rating" value="4" />
    <label for="first-rate4" title="Very good">4 stars</label>
    <input type="radio" id="first-rate5" name="rating" value="5" />
    <label for="first-rate5" title="Amazing">5 stars</label>
  </fieldset>
        </div>

        <div>
            <label for="review" class="form-label">Review:</label>
            <textarea name="comment" id="review" class="form-control" placeholder="Write a Review.." rows="10" cols="30" required></textarea>
            <div class="invalid-feedback">Please add some comments for review</div>
        </div>
        <button class="btn btn-outline-dark mt-3 mb-3">Submit</button>
    </form>
    </div>
    <% } %>
    
     <div class="row col-6 offset-3 mt-4">
        <hr>
          <h4>All Reviews:</h4>
          <div class="row">
          <% for(let el of list.reviews){ %>
            <div class="card col-5 mb-3 ms-2">
             <div class="card-body">
               <h5 class="card-title mt-2">@<%= el.author.username %></h5>
                <p class="starability-result card-text" data-rating="<%= el.rating %>"></p>
               <p class="card-text"><%= el.comment %></p>
              </div> 
              <form class="mb-2 mt-2" method="POST" action="/listing/<%= list._id %>/reviews/<%= el._id %>?_method=DELETE">
                <button class="btn btn-sm btn-dark">Delete</button>
               </form>
          </div>     
          <% } %>
          </div>   
    </div>
    <script src="/css/js/map.js?v=4"></script>
