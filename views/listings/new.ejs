<% layout('layouts/boilerplate') -%>
<body>
  <br><br><br>
    <div class="row">
      <div class="col-8 offset-2">
    <h3>Create New Listing</h3><br>
    <form method="post" action="/listing" class="needs-validation" novalidate enctype="multipart/form-data">
   
   <!-- Title -->
    <div class="mb-3">
      <label for="title" class="form-label">Title:</label>
  <input
    type="text"
    id="title"
    name="listing[title]"
    class="form-control"
    placeholder="Add a catchy title"
    required
  />
  <div class="valid-feedback">
      Looks good!
    </div>
    <div class="invalid-feedback">Please enter a title</div>
    </div>

  <div class="mb-3">  <!-- Description -->
  <label for="description"  class="form-label">Description:</label>
  <textarea id="description" class="form-control" name="listing[description]" rows="4" required></textarea>
  <div class="invalid-feedback">Please enter a short description</div>
  <div class="valid-feedback">
      Looks good!
    </div>
</div>

  <div class="mb-3">  <!-- Image URL -->
  <label for="image"  class="form-label">Upload Image:</label>
  <input
    type="file"
    class="form-control"
    id="image"
    name="listing[image]"
  /></div>

  <div class="row">
<div class="mb-3 col-md-4"> <!-- Price -->
  <label for="price"  class="form-label">Price:</label>
  <input
    type="number"
    class="form-control"
    id="price"
    name="listing[price]"
    min="0"
    placeholder="Enter price"
    required
  />
  <div class="invalid-feedback">Price should be valid</div>
</div>

<div class="mb-3 col-md-8">  <!-- Country -->
  <label for="country"  class="form-label">Country:</label>
  <input
    type="text"
    class="form-control"
    id="country"
    name="listing[country]"
    placeholder="Enter country"
    required
  />
  <div class="invalid-feedback">Country name is required</div>
</div>
  </div>
  
<div class="mb-3">  <!-- Location -->
  <label for="location"  class="form-label">Location:</label>
  <input
    type="text"
    class="form-control"
    id="location"
    name="listing[location]"
    placeholder="City or Area"
    required
  />
  <div class="invalid-feedback">Location is required</div>
</div>
   <br><br>
  <button class="btn btn-dark add-btn">Add</button> 
  </div>
</form>
 </div>
</body>
