<% layout('layouts/boilerplate') -%>
<body>
   <div class="row">
    <div class="col-8 offset-2 mt-3"><br><br>

    <h3>Edit Listing</h3><br>
    <form method="post" action="/listing/<%= list._id%>?_method=PUT" class="needs-validation" enctype="multipart/form-data" novalidate>
  
  <div class="mb-3">
   <!-- Title -->
  <label for="title" class="form-label ">Title:</label>
  <input
    type="text"
     class="form-control"
    id="title"
    name="listing[title]"
    value="<%= list.title %>"
    required
    /><br>
    <div class="valid-feedback">
      Looks good!
    </div>
    <div class="invalid-feedback">Please enter a title</div>
  </div>
  
    <div class="mb-3">
  <!-- Description -->
  <label for="description" class="form-label">Description:</label>
  <textarea id="description"  class="form-control" name="listing[description]" required><%= list.description %></textarea><br>
  <div class="invalid-feedback">Please enter a short description</div>
  <div class="valid-feedback">
      Looks good!
    </div>
  </div>

  <div class="mb-3">
   Original Image: <br>
   <img src="<%= imageUrl %>">

  </div>
  
  
  <div class="mb-3">
  <!-- Image URL -->
  <label for="image" class="form-label">Upload New Image:</label>
  <input
    type="file"
     class="form-control"
    id="image"
    name="listing[image]"
    value="<%= list.image.url %>"
  /><br>
  </div>

  <div class="row" >
  <div class="mb-3 col-md-4">
  <!-- Price -->
  <label for="price" class="form-label">Price:</label>
  <input
    type="number"
     class="form-control"
    id="price"
    name="listing[price]"
    min="0"
   value="<%= list.price %>"
   required
  /><br>
   <div class="invalid-feedback">Price should be valid</div>
  </div>

    <div class="mb-3 col-md-8">
  <!-- Location -->
  <label for="location" class="form-label">Location:</label>
  <input
    type="text"
     class="form-control"
    id="location"
    name="listing[location]"
    placeholder="City or Area"
    value="<%= list.location %>"
    required
  /><br>
   <div class="invalid-feedback">Location is required</div>
  </div>

  </div>
    <div class="mb-3">
  <!-- Country -->
  <label for="country" class="form-label">Country:</label>
  <input
    type="text"
     class="form-control"
    id="country"
    name="listing[country]"
    value="<%= list.country %>"
    required
  /><br>
  <div class="invalid-feedback">Country name is required</div>
  </div>

  <button class="btn btn-dark edit-btn">Edit</button>
</form>
</div>
</div>
</body>
